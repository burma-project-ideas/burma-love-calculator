@page "/"
@inject LoveCalculatorService CalcService

<PageTitle>Love Calculator | Premium Red Edition</PageTitle>

<main id="main-content" class="app-shell min-h-screen px-4 py-8 md:px-8 md:py-14">
    <div class="mx-auto max-w-4xl">
        <header class="page-header">
            <img src="love-icon.svg" alt="" aria-hidden="true" class="brand-mark" />
            <p class="eyebrow">A small name game</p>
            <h1 class="page-title text-5xl md:text-7xl">Love Calculator</h1>
            <p class="page-intro">
                Enter two English names for a playful compatibility score and a clear view of how it was calculated.
            </p>
        </header>

        <section class="calculator-card" aria-labelledby="calculator-heading">
            <div class="form-intro">
                <p class="eyebrow">Name match</p>
                <h2 id="calculator-heading" class="section-title">Check two names</h2>
                <p id="names-help" class="supporting-text">Both fields are required. Only English letters A–Z are counted.</p>
            </div>

            <form @onsubmit="HandleCalculate" @onsubmit:preventDefault="true">
                <fieldset class="name-grid">
                    <legend class="sr-only">Names to compare</legend>

                    <div class="field-group">
                        <label for="first-name" class="field-label">First person</label>
                        <input id="first-name"
                               name="first-name"
                               type="text"
                               @bind="firstName"
                               @bind:event="oninput"
                               required
                               maxlength="80"
                               autocomplete="off"
                               aria-describedby="names-help name-error"
                               aria-invalid="@(string.IsNullOrEmpty(error) ? "false" : "true")"
                               class="input-luxe" />
                    </div>

                    <div class="field-group">
                        <label for="second-name" class="field-label">Second person</label>
                        <input id="second-name"
                               name="second-name"
                               type="text"
                               @bind="secondName"
                               @bind:event="oninput"
                               required
                               maxlength="80"
                               autocomplete="off"
                               aria-describedby="names-help name-error"
                               aria-invalid="@(string.IsNullOrEmpty(error) ? "false" : "true")"
                               class="input-luxe" />
                    </div>
                </fieldset>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div id="name-error" class="error-bar" role="alert">
                        <strong>Please check the names.</strong>
                        <span>@error</span>
                    </div>
                }

                <button type="submit" class="button-luxe">Calculate compatibility</button>
            </form>

            <div aria-live="polite" aria-atomic="true">
                @if (result is { Ok: true })
                {
                    <section class="result-panel" aria-labelledby="result-heading">
                        <p class="eyebrow">Your result</p>
                        <p class="result-score">@result.Percentage%</p>
                        <h2 id="result-heading" class="result-title">@GetCompatibilityMessage(result.Percentage)</h2>
                        <p class="supporting-text">
                            @firstName and @secondName have @result.Percentage% compatibility in this name game.
                        </p>
                        <label for="compatibility-progress" class="sr-only">Compatibility score</label>
                        <progress id="compatibility-progress" class="score-progress" max="100" value="@result.Percentage">
                            @result.Percentage%
                        </progress>
                    </section>
                }
            </div>
        </section>

        @if (result is { Ok: true } && result.Trace.Count > 0)
        {
            <details class="steps-card">
                <summary>
                    <span>How the score was calculated</span>
                    <span class="summary-meta">@result.Trace.Count rounds</span>
                </summary>

                <div class="steps-content">
                    <p class="supporting-text">
                        Each round pairs values from the outside in until two digits remain.
                    </p>

                    <ol class="trace-list">
                        @foreach (var step in result.Trace)
                        {
                            <li class="trace-row">
                                <h3>Round @step.Round</h3>
                                <dl class="trace-values">
                                    <div>
                                        <dt>Input</dt>
                                        <dd>
                                            @foreach (var value in step.Input)
                                            {
                                                <span class="number-chip">@value</span>
                                            }
                                        </dd>
                                    </div>
                                    <div>
                                        <dt>Output</dt>
                                        <dd>
                                            @foreach (var value in step.Output)
                                            {
                                                <span class="number-chip">@value</span>
                                            }
                                        </dd>
                                    </div>
                                </dl>
                            </li>
                        }
                    </ol>
                </div>
            </details>
        }

        <footer class="page-footer">
            For fun only—not a scientific relationship metric. Powered by .NET 10.
        </footer>
    </div>
</main>

@code {
    private string firstName = "";
    private string secondName = "";
    private string error = "";
    private CalculationResult? result;

    private void HandleCalculate()
    {
        if (string.IsNullOrWhiteSpace(firstName) || string.IsNullOrWhiteSpace(secondName))
        {
            error = "Enter both names to calculate compatibility.";
            result = null;
            return;
        }

        error = "";
        result = CalcService.CalculateCompatibility(firstName, secondName);

        if (!result.Ok)
        {
            error = result.Error;
            result = null;
        }
    }

    private static string GetCompatibilityMessage(int percentage)
    {
        if (percentage >= 90) return "S-tier match";
        if (percentage >= 80) return "High-voltage chemistry";
        if (percentage >= 70) return "Strong alignment";
        if (percentage >= 60) return "Solid connection";
        if (percentage >= 50) return "Balanced potential";
        return "Low resonance";
    }
}
